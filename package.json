{
  "name": "expense-settlement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "copy:pdf-worker": "node -e \"const fs=require('fs'),path=require('path');const pdfjs=path.dirname(require.resolve('pdfjs-dist/package.json',{paths:[path.dirname(require.resolve('react-pdf/package.json'))]}));fs.mkdirSync('public',{recursive:true});fs.copyFileSync(path.join(pdfjs,'build/pdf.worker.min.mjs'),'public/pdf.worker.min.mjs')\"",
    "predev": "npm run copy:pdf-worker",
    "dev": "vite",
    "prebuild": "npm run copy:pdf-worker",
    "build": "vite build",
    "preview": "vite preview",
    "tsc": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "node --test tests/*.test.cjs",
    "postbuild": "node tests/check-production.cjs",
    "package": "npm run build && node -e \"require('fs').mkdirSync('deploy',{recursive:true})\" && cd dist && rm -f ../deploy/expense-settlement-app.zip && zip -qr -X ../deploy/expense-settlement-app.zip ."
  },
  "dependencies": {
    "@valance/sdk": "file:./vendor/valance-sdk",
    "axios": "^1.21.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
