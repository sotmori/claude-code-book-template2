# Local development only. Copy this file to `.env.development`:
#
#   cp .env.development.example .env.development
#
# Vite loads `.env.development` ONLY for `npm run dev`; nothing here is included
# in a production build (`npm run build`), so a deployed app always derives its
# appId from the serving URL and calls the API on its own origin (/v1).

# ORIGIN of the environment you want to develop against. `npm run dev` proxies
# /v1/* there, so login and every data call use live data with no CORS setup.
# Use the address you open the portal on — a cloud portal domain or an
# on-premise appliance, e.g.
#   VITE_API_TARGET=https://portal.example.com
#   VITE_API_TARGET=http://valance-op-e2fd.local
VITE_API_TARGET=

# Your app's UUID: the 32 hex characters of its default host a-{32 hex}.vcapp.…
# written as 8-4-4-4-12 (for a marketplace install, the installed app's id).
# On localhost the serving path is "/", so the runtime appId derivation cannot
# work — this override stands in for it in dev only.
VITE_APP_ID=
